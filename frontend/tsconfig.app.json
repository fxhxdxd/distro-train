{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    // Unused-locals/params are intentionally OFF for the redesign workflow:
    // heavy UI churn (temporarily commenting out usages, stubbing components)
    // would otherwise fail the type-check gate on TS6133 noise. Real contract
    // breaks — wrong/missing props, incompatible types — still fail via
    // TS2322/2345/2741/2339. Run `eslint .` for cosmetic unused-import cleanup.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // This project type-checks renderer/UI code only. Electron main-process code
  // (which transitively pulls in electron-store → json-schema-typed) is
  // compiled separately via `npm run transpile:electron`.
  "exclude": ["src/electron"],
  "include": ["src"]
}
